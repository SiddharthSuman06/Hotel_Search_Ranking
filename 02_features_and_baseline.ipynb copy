        "period.iloc[int(n * 0.8):] = 'test'\n",
        "df['period'] = df['srch_id'].map(period)\n",
        "\n",
        "summary = df.groupby('period').agg(searches=('srch_id', 'nunique'),\n",
        "                                   first_day=('date_time', 'min'),\n",
        "                                   last_day=('date_time', 'max'))\n",
        "print(summary.loc[['history', 'train', 'test']])"
