      "source": [
        "## Features\n",
        "\n",
        "Every feature here is something Expedia would know at the moment a search happens. Most of them compare a hotel with **the other hotels in the same search**, because that's how a guest judges a result: is this one cheaper, better rated or better located than the others on my screen?"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "cb9f3b4d",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cb9f3b4d",
        "outputId": "de676a46-e37d-4442-d786-e30c9b1b36b2"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Features built\n"
          ]
        }
      ],
      "source": [
        "g = df.groupby('srch_id')\n",
        "\n",
        "# Price, judged against the rest of the list\n",
        "df['log_price'] = np.log1p(df['price_usd'])\n",
        "df['price_rank'] = g['price_usd'].rank(pct=True)                   # 0 = cheapest in the search\n",
        "df['price_vs_search_avg'] = df['price_usd'] / g['price_usd'].transform('mean')\n",
        "\n",
        "# Is today's price cheap or dear for this hotel?\n",
        "df['historical_price'] = np.exp(df['prop_log_historical_price'])\n",
        "df['price_vs_usual'] = df['price_usd'] / df['historical_price']\n",
        "\n",
        "# Quality and location, also ranked within the search\n",
        "df['star_rank'] = g['prop_starrating'].rank(pct=True)\n",
        "df['review_rank'] = g['prop_review_score'].rank(pct=True)\n",
        "df['location1_rank'] = g['prop_location_score1'].rank(pct=True)\n",
        "\n",
        "# Fill missing location score 2 with the typical value for that destination\n",
        "dest_median = df.groupby('srch_destination_id')['prop_location_score2'].transform('median')\n",
        "df['location2_filled'] = (df['prop_location_score2']\n",
        "                          .fillna(dest_median)\n",
        "                          .fillna(df['prop_location_score2'].median()))\n",
        "df['location2_rank'] = df.groupby('srch_id')['location2_filled'].rank(pct=True)\n",
        "\n",
        "# What we know about the guest\n",
        "df['visitor_known'] = df['visitor_hist_starrating'].notna().astype(int)\n",
        "df['star_gap_to_visitor'] = (df['prop_starrating'] - df['visitor_hist_starrating']).abs()\n",
        "df['price_gap_to_visitor'] = (df['price_usd'] - df['visitor_hist_adr_usd']).abs()\n",
        "\n",
        "df['hotels_in_search'] = g['prop_id'].transform('size')\n",
        "print(\"Features built\")"
      ]
